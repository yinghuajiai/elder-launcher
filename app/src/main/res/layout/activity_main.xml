<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_permission_center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <!-- 危险权限：一键全授 -->
        <Button
            android:id="@+id/btn_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_all_runtime" />

        <Button
            android:id="@+id/btn_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_storage" />

        <Button
            android:id="@+id/btn_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_location" />

        <Button
            android:id="@+id/btn_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_phone" />

        <Button
            android:id="@+id/btn_sms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_sms" />

        <Button
            android:id="@+id/btn_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_contacts" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- 特殊权限：跳系统设置 -->
        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_overlay" />

        <Button
            android:id="@+id/btn_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_usage" />

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_battery" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 无障碍服务 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_accessibility"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_accessibility" />

        <Button
            android:id="@+id/btn_read_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_read_notifications" />

        <Button
            android:id="@+id/btn_tap_read"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_tap_read" />
    </LinearLayout>
</ScrollView>